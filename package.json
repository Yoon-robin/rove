{
  "name": "rove",
  "productName": "Rove",
  "version": "1.5.3",
  "private": true,
  "description": "Rove: a browser by Robin (Electron)",
  "main": "main.cjs",
  "license": "GPL-3.0-only",
  "author": "Yoon-robin",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yoon-robin/rove.git"
  },
  "scripts": {
    "start": "electron .",
    "release": "node ../scripts/release-rove.mjs",
    "build": "electron-packager . Rove --platform=win32 --arch=x64 --out=out --overwrite --asar --icon=rove.ico --app-copyright=yoonrobin.xyz --win32metadata.FileDescription=Rove --win32metadata.ProductName=Rove --ignore=^/out --ignore=^/test --ignore=^/tools --ignore=^/rove-256.png --ignore=^/README.md"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "electron": "45.5.0",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@ghostery/adblocker": "2.20.3",
    "@mozilla/readability": "0.6.0",
    "electron-chrome-extensions": "4.10.0",
    "electron-chrome-web-store": "0.13.0",
    "hash-wasm": "4.13.0",
    "tldts": "7.4.21"
  }
}
