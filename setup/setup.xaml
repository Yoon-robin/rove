<!-- Rove setup window: brand kit V5 (the Recurrence menu) in WPF. Values are docs/brand.md's:
     faces #0a0e11 side · #0e1012 page · #0f1115 card, 1px line #181a1d, one blue fill, weights 450/550/650.
     Setup.cs loads this, sets the font and wires the parts it names (x:Name). -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rove 설치" Width="752" Height="492" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">
  <Window.Resources>
    <SolidColorBrush x:Key="Side" Color="#0a0e11"/>
    <SolidColorBrush x:Key="Page" Color="#0e1012"/>
    <SolidColorBrush x:Key="Card" Color="#0f1115"/>
    <SolidColorBrush x:Key="Line" Color="#181a1d"/>
    <SolidColorBrush x:Key="CardTop" Color="#212428"/>
    <SolidColorBrush x:Key="Control" Color="#14151c"/>
    <SolidColorBrush x:Key="ControlLine" Color="#26272d"/>
    <SolidColorBrush x:Key="Chosen" Color="#222629"/>
    <SolidColorBrush x:Key="Head" Color="#f0f0f0"/>
    <SolidColorBrush x:Key="Text" Color="#e6e7e9"/>
    <SolidColorBrush x:Key="Soft" Color="#8a8e94"/>
    <SolidColorBrush x:Key="Faint" Color="#7d8187"/>
    <SolidColorBrush x:Key="Accent" Color="#4b7dfe"/>
    <SolidColorBrush x:Key="Alarm" Color="#e5475a"/>

    <!-- group label: outside the card, small and faint -->
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="550"/>
      <Setter Property="Foreground" Value="{StaticResource Faint}"/>
      <Setter Property="Margin" Value="14,15,0,9"/>
    </Style>
    <Style x:Key="RowName" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="550"/>
      <Setter Property="Foreground" Value="{StaticResource Head}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="RowValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="450"/>
      <Setter Property="Foreground" Value="{StaticResource Soft}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- a card: its top line a shade lighter than its sides (V5.1 "light is height") -->
    <Style x:Key="CardBox" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="Row" TargetType="Grid">
      <Setter Property="Height" Value="41"/>
      <Setter Property="Margin" Value="15,0,15,0"/>
    </Style>

    <!-- the V5 switch: 34x19, knob 13; on is the blue with a white knob. The slide (165 ms) is
         played by Setup.cs on a press only, so the window opens with the knobs already in place. -->
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid Width="38" Height="23">
              <Border x:Name="Ring" CornerRadius="11.5" BorderThickness="2" BorderBrush="Transparent"/>
              <Border x:Name="Track" Width="34" Height="19" CornerRadius="9.5" Background="#030913" BorderBrush="{StaticResource ControlLine}" BorderThickness="1"/>
              <Ellipse x:Name="Knob" Width="13" Height="13" Fill="#798895" HorizontalAlignment="Left" Margin="5,0,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Move" X="0"/></Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,5,0"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="#994b7dfe"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- V5 buttons: control face, and the one blue fill. Pressed gives to 0.97. -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="{StaticResource Control}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ControlLine}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="550"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Ring" CornerRadius="9" Margin="-3" BorderThickness="2" BorderBrush="Transparent"/>
              <Border x:Name="Face" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="#1b1d25"/>
                <Setter TargetName="Face" Property="BorderBrush" Value="#32343b"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="#994b7dfe"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.97" Duration="0:0:0.16"/>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.97" Duration="0:0:0.16"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Lead" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#3d6af0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Ring" CornerRadius="9" Margin="-3" BorderThickness="2" BorderBrush="Transparent"/>
              <Border x:Name="Face" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#4b7dfe"/></Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Background" Value="#3562e0"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.97" Duration="0:0:0.16"/>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.97" Duration="0:0:0.16"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="#994b7dfe"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- removing: the kit's danger fill (rk-btn danger-fill), in place of the blue -->
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Lead}">
      <Setter Property="Background" Value="#d52236"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Ring" CornerRadius="9" Margin="-3" BorderThickness="2" BorderBrush="Transparent"/>
              <Border x:Name="Face" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.97" Duration="0:0:0.16"/>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.97" Duration="0:0:0.16"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="#99e5475a"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- the round close button of the kit (.rk-round) -->
    <Style x:Key="Round" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Width="28" Height="28" CornerRadius="14" Background="#8c000000" BorderBrush="Transparent" BorderThickness="2">
              <Viewbox Width="12" Height="12"><Path Data="M6 6l12 12M18 6L6 18" Stroke="{StaticResource Soft}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/></Viewbox>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#1b1d25"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#994b7dfe"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- the margin leaves room for the window's shadow -->
  <Border Margin="16" CornerRadius="14" Background="{StaticResource Page}" BorderBrush="#17191b" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.6" Color="Black"/></Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="208"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- the side column: who it is, then the steps as Rove's own rows -->
      <Border x:Name="Side" Grid.Column="0" Background="{StaticResource Side}" CornerRadius="13,0,0,13" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <DockPanel Margin="9,14,9,12">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,0">
            <Border Width="30" Height="30" CornerRadius="7" Background="#060a14" BorderBrush="#1a2236" BorderThickness="1">
              <TextBlock Text="R" FontSize="17" FontWeight="650" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#4b7dfe" Opacity="0.9"/></TextBlock.Effect>
              </TextBlock>
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Rove" FontSize="15" FontWeight="650" Foreground="{StaticResource Head}"/>
              <TextBlock Text="A browser by Robin" FontSize="11.5" FontWeight="450" Foreground="{StaticResource Faint}"/>
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="SideLabel" DockPanel.Dock="Top" Text="설치" Style="{StaticResource Label}" Margin="6,20,0,6"/>
          <StackPanel x:Name="Steps" DockPanel.Dock="Top"/>
          <Border/>
        </DockPanel>
      </Border>

      <DockPanel Grid.Column="1">
        <!-- top bar: the version, and close -->
        <Border x:Name="Bar" DockPanel.Dock="Top" Height="56" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
          <Grid Margin="20,0,14,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="Title" Text="Rove" FontSize="15" FontWeight="650" Foreground="{StaticResource Head}" VerticalAlignment="Center"/>
              <TextBlock x:Name="Build" FontSize="12.5" FontWeight="450" Foreground="{StaticResource Faint}" Margin="10,1,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="Close" Style="{StaticResource Round}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="닫기"/>
          </Grid>
        </Border>

        <!-- bottom: what is happening, and the two buttons -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,14,16,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
              <Grid>
                <TextBlock x:Name="Status" FontSize="13" FontWeight="550" Foreground="{StaticResource Text}"/>
                <TextBlock x:Name="Amount" FontSize="12.5" FontWeight="450" Foreground="{StaticResource Faint}" HorizontalAlignment="Right"/>
              </Grid>
              <!-- the kit's slider track, filled in the blue as it goes -->
              <Grid x:Name="Track" Height="4" Margin="0,9,0,0">
                <Border Background="{StaticResource Control}" CornerRadius="2"/>
                <Border x:Name="Fill" Background="{StaticResource Accent}" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
              </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="Cancel" Style="{StaticResource Btn}" Content="닫기" Margin="0,0,8,0"/>
              <Button x:Name="Go" Style="{StaticResource Lead}" Content="설치" MinWidth="88" IsDefault="True"/>
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel x:Name="InstallCards" Margin="14,4,14,0">
          <TextBlock Text="설치할 곳" Style="{StaticResource Label}"/>
          <Border Style="{StaticResource CardBox}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <TextBlock Text="폴더" Style="{StaticResource RowName}"/>
                <TextBlock x:Name="Folder" Style="{StaticResource RowValue}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="80,0,0,0"/>
              </Grid>
              <Border Height="1" Background="{StaticResource Line}" Margin="9,0"/>
              <Grid Style="{StaticResource Row}">
                <TextBlock Text="크기" Style="{StaticResource RowName}"/>
                <TextBlock x:Name="Size" Style="{StaticResource RowValue}"/>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="바로가기" Style="{StaticResource Label}"/>
          <Border Style="{StaticResource CardBox}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <TextBlock Text="바탕화면" Style="{StaticResource RowName}"/>
                <ToggleButton x:Name="Desk" Style="{StaticResource Switch}" IsChecked="True" AutomationProperties.Name="바탕화면 바로가기"/>
              </Grid>
              <Border Height="1" Background="{StaticResource Line}" Margin="9,0"/>
              <Grid Style="{StaticResource Row}">
                <TextBlock Text="시작 메뉴" Style="{StaticResource RowName}"/>
                <ToggleButton x:Name="Menu" Style="{StaticResource Switch}" IsChecked="True" AutomationProperties.Name="시작 메뉴 바로가기"/>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="끝나면" Style="{StaticResource Label}"/>
          <Border Style="{StaticResource CardBox}">
            <Grid Style="{StaticResource Row}">
              <TextBlock Text="Rove 켜기" Style="{StaticResource RowName}"/>
              <ToggleButton x:Name="Open" Style="{StaticResource Switch}" IsChecked="True" AutomationProperties.Name="끝나면 Rove 켜기"/>
            </Grid>
          </Border>
        </StackPanel>

        <!-- removing (the uninstall mode): what goes, and whether the person's own things go with it -->
        <StackPanel x:Name="RemoveCards" Margin="14,4,14,0" Visibility="Collapsed">
          <TextBlock Text="지울 것" Style="{StaticResource Label}"/>
          <Border Style="{StaticResource CardBox}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <TextBlock Text="폴더" Style="{StaticResource RowName}"/>
                <TextBlock x:Name="RFolder" Style="{StaticResource RowValue}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="80,0,0,0"/>
              </Grid>
              <Border Height="1" Background="{StaticResource Line}" Margin="9,0"/>
              <Grid Style="{StaticResource Row}">
                <TextBlock Text="크기" Style="{StaticResource RowName}"/>
                <TextBlock x:Name="RSize" Style="{StaticResource RowValue}"/>
              </Grid>
              <Border Height="1" Background="{StaticResource Line}" Margin="9,0"/>
              <Grid Style="{StaticResource Row}">
                <TextBlock Text="바로가기" Style="{StaticResource RowName}"/>
                <TextBlock x:Name="RLinks" Style="{StaticResource RowValue}"/>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="같이 지우기" Style="{StaticResource Label}"/>
          <Border Style="{StaticResource CardBox}">
            <Grid Style="{StaticResource Row}">
              <TextBlock Text="방문 기록·즐겨찾기·로그인" Style="{StaticResource RowName}"/>
              <ToggleButton x:Name="Mine" Style="{StaticResource Switch}" IsChecked="False" AutomationProperties.Name="방문 기록·즐겨찾기·로그인도 지우기"/>
            </Grid>
          </Border>
        </StackPanel>
      </DockPanel>
    </Grid>
  </Border>
</Window>
